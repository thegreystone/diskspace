<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>se.hirt</groupId>
    <artifactId>diskspace</artifactId>
    <version>0.2.8-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>DiskSpace</name>
    <description>A cross-platform disk space visualizer in Java + JavaFX.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <javafx.version>21.0.7</javafx.version>
        <main.class>se.hirt.diskspace.App</main.class>

        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.2</surefire-plugin.version>
        <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
        <gluonfx-maven-plugin.version>1.0.27</gluonfx-maven-plugin.version>
        <graalvm-sdk.version>24.2.0</graalvm-sdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- GraalVM Native Image API. Provides the @CFunction / @CContext / etc. annotations
             we use to call Win32 system DLLs directly from MftScanner + WindowsElevation.
             Compile scope (not provided): the SDK classes need to be on the JVM-mode runtime
             classpath too, because MftScanner's class graph references PointerBase/Pointer/
             ComparableWord at field-type level. Class load happens as soon as Scanner.forVolume
             reaches MftScanner.canScan, even though canScan is guarded to return false in JVM
             mode. Native-image build coexists fine — substrate uses its own SDK version. -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>${graalvm-sdk.version}</version>
        </dependency>


        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
            </plugin>

            <!-- Dev runner: `mvn javafx:run` launches the app on the JVM. MFT scanning is
                 disabled in JVM mode (the @CFunction bindings only resolve in native-image
                 builds), so dev mode falls back to the parallel directory scanner. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx-maven-plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Debug logging + JFR for `mvn javafx:run`:
            * -Ddiskspace.log.level=FINE   → se.hirt.diskspace.* logs at FINE level
            * StartFlightRecording=...     → JFR recording running for the whole session,
                                              dumped to diskspace.jfr in the working dir on
                                              exit. Open with `jfr summary diskspace.jfr`
                                              or load in JDK Mission Control / VisualVM.
                                              `settings=profile` captures methods + locks +
                                              GC + allocation; heavier than `default` but
                                              what you want for diagnosing freezes.
          Run: `mvn -Pdebug-logging javafx:run`
        -->
        <profile>
            <id>debug-logging</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <options>
                                <option>-Ddiskspace.log.level=FINE</option>
                                <option>
                                    -XX:StartFlightRecording=name=diskspace,filename=diskspace.jfr,dumponexit=true,settings=profile
                                </option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Native build via Gluon Substrate.
          Run: `mvn -Pnative gluonfx:build gluonfx:nativerun`
          Prerequisites: Oracle GraalVM for JDK 21 LTS + native-image, plus platform toolchain
            (Windows: VS 2022 with C++ workload; macOS: Xcode CLT; Linux: gcc + dev headers).
          GC note: native-image on Windows is stuck with Serial GC. The G1 collector
          is Oracle-GraalVM-only AND Linux-only, so on Windows we tune Serial instead
          (capped max heap below). Linux native-image builds could opt into G1 by
          adding the gc flag in an OS-specific profile if that becomes worthwhile.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.gluonhq</groupId>
                        <artifactId>gluonfx-maven-plugin</artifactId>
                        <version>${gluonfx-maven-plugin.version}</version>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <nativeImageArgs>
                                <!-- Cap the heap at 4 GB. Serial GC's stop-the-world full
                                     collections scale with heap size; without a cap, Substrate
                                     ergonomics let the heap grow toward 80% of physical RAM
                                     (MaximumHeapSizePercent=80), which on a 64 GB machine
                                     means full GCs that pause for seconds. 4 GB is comfortable
                                     for a multi-TB volume scan (the DirectoryNode tree for
                                     ~4 M files is well under 1 GB) and keeps worst-case Serial
                                     pauses bounded. -->
                                <arg>-R:MaxHeapSize=4g</arg>
                                <!-- Pin the initial heap at 1 GB so a large scan doesn't trigger
                                     a sequence of stop-the-world heap-expansion GCs as the
                                     DirectoryNode tree grows from ~0 → ~hundreds of MB. Default
                                     is 0 (no floor, heap starts at a few MB and grows under
                                     pressure), which produced the visible mid-scan pauses. 1 GB
                                     covers a typical home-directory scan in one shot; bigger
                                     scans still grow naturally toward MaxHeapSize=4g, just
                                     starting from a sensible floor instead of from a few MB.
                                     Note on diagnosis: `-XX:PrintFlags=` reports these as 0
                                     even when set — it prints option-definition defaults, not
                                     effective values. The GC startup banner ("Maximum heap
                                     size: …") is the authoritative readout, not PrintFlags. -->
                                <arg>-R:MinHeapSize=1g</arg>
                                <!-- Bake GC logging in by default so production builds can be
                                     diagnosed without a custom build. Cost is ~300 bytes of
                                     binary size (these flags flip defaults of already-compiled
                                     Serial-GC logging paths; no extra code pulled in). Output
                                     goes to stdout, which is /dev/null when the .app is launched
                                     from Finder but visible when launched from a terminal:
                                       /Applications/DiskSpace.app/Contents/MacOS/DiskSpace
                                     Run that line in Terminal to see GC events live. The
                                     `-R:+PrintGCTimeStamps` prefix on each line lets you
                                     correlate pauses with scanner log timestamps. -->
                                <arg>-R:+PrintGC</arg>
                                <arg>-R:+VerboseGC</arg>
                                <arg>-R:+PrintGCTimeStamps</arg>
                                <!-- Enable Flight Recorder so production builds can capture
                                     JFR recordings (App.maybeStartJfrRecording auto-starts one
                                     when `-debug` is passed). On Oracle GraalVM 21+ Substrate
                                     these flags both link the JFR JNI symbols AND produce a
                                     working FlightRecorder. On Gluon Substrate they have
                                     historically been accepted but produced no working engine
                                     (gluonhq/substrate#1354) — that's why the prior `native-jfr`
                                     profile carried a "currently a no-op" warning. DiskView's
                                     defensive JFR guard handles the no-op case gracefully. -->
                                <arg>--enable-monitoring=jfr</arg>
                                <arg>-R:+FlightRecorder</arg>
                                <!-- Quarantine the build-host JVM from other Java processes on
                                     the box. Without this, when a JMX/RMI client is running
                                     (e.g. JDK Mission Control, IntelliJ's RemoteMavenServer with
                                     -Dsun.rmi.server.exceptionTrace=true), it discovers the
                                     build JVM via hsperfdata and probes its attach socket. That
                                     triggers the platform management agent to load, whose static
                                     init drags in javax.management.remote.rmi → sun.rmi.* helper
                                     types. Substrate has those on its initialize-at-run-time list
                                     and aborts the build with "Classes that should be initialized
                                     at run time got initialized during image building".
                                       -J-XX:-UsePerfData       — skip writing hsperfdata, so
                                                                  monitoring tools don't see us.
                                       -J-XX:+DisableAttachMechanism — refuse incoming attach
                                                                  requests, so even tools that
                                                                  guess our PID can't trigger
                                                                  agent load.
                                     Both flags target the host JVM only (the -J prefix); the
                                     produced binary is unaffected. -->
                                <arg>-J-XX:-UsePerfData</arg>
                                <arg>-J-XX:+DisableAttachMechanism</arg>
                            </nativeImageArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Mac-auto-activated. Adds the DiskArbitration framework to the gluonfx link step
          so MacStorageProbe's @CFunction bindings to DASessionCreate / DADiskCopyDescription /
          DADiskCreateFromVolumePath resolve at link time.

          Note: must use <linkerArgs> (passed to the final clang/gcc link command), not
          <nativeImageArgs> (passed only to native-image, which writes a relocatable .o
          and doesn't invoke the system linker itself). Substrate's hardcoded macOS link
          line includes Foundation / AppKit / ApplicationServices / OpenGL / QuartzCore /
          Security / Accelerate but not DiskArbitration; this entry appends one more
          framework to that list. CoreFoundation is already linked transitively via
          Foundation, so no -framework CoreFoundation needed here.

          Profile activates on every Mac Maven invocation but is inert outside
          `gluonfx:build` / `gluonfx:link` — the linker args only flow to those goals.
        -->
        <profile>
            <id>native-mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.gluonhq</groupId>
                        <artifactId>gluonfx-maven-plugin</artifactId>
                        <version>${gluonfx-maven-plugin.version}</version>
                        <configuration>
                            <linkerArgs>
                                <!-- DiskArbitration: DASessionCreate / DADiskCreateFromVolumePath /
                                     DADiskCopyDescription / DADiskGetBSDName.
                                     IOKit: IOBSDNameMatching / IOServiceGetMatchingService /
                                     IORegistryEntrySearchCFProperty / IOObjectRelease — used for the
                                     parent-chain walk that resolves Medium Type ("Solid State" vs
                                     "Rotational") for APFS volumes whose own DA description doesn't
                                     surface DAMediaSolidState. -->
                                <arg>-Wl,-framework,DiskArbitration</arg>
                                <arg>-Wl,-framework,IOKit</arg>
                                <!-- libmanagement_ext provides com.sun.management.OperatingSystemImpl's
                                     JNI methods (getFreeMemorySize0, getTotalMemorySize0, initialize0).
                                     JFR pulls these in when `enable-monitoring=jfr` is on, but
                                     Substrate's default macOS link line doesn't link this static lib.
                                     Without it the link step fails with "Undefined symbols for
                                     architecture arm64: _Java_com_sun_management_internal_…". The
                                     .a lives in $GRAALVM_HOME/lib/static/darwin-aarch64/ and is on
                                     the -L search path already, so the bare -l flag is enough. -->
                                <arg>-lmanagement_ext</arg>
                            </linkerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Linux-auto-activated. Same `-lmanagement_ext` story as native-mac: with
          `enable-monitoring=jfr` on in the `native` profile, JFR pulls in
          com.sun.management.OperatingSystemImpl whose JNI methods live in
          libmanagement_ext.a, and Substrate's default Linux link line doesn't include
          it. Without this entry the link step fails with
            "undefined reference to `Java_com_sun_management_internal_OperatingSystemImpl_initialize0'"
          on the Linux CI runner. The .a lives in $GRAALVM_HOME/lib/static/linux-amd64/
          (or linux-aarch64/ when we ship that flavour) and Substrate's -L search path
          already covers that directory, so the bare -l is enough.
        -->
        <profile>
            <id>native-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.gluonhq</groupId>
                        <artifactId>gluonfx-maven-plugin</artifactId>
                        <version>${gluonfx-maven-plugin.version}</version>
                        <configuration>
                            <linkerArgs>
                                <arg>-lmanagement_ext</arg>
                            </linkerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Builds the native exe as a Windows console-subsystem binary so stdout/stderr stay
          attached to the launching shell. GC logging is on by default in the `native`
          profile, so a console build streams GC events live:
            `mvn -Pnative,native-console gluonfx:build`
            target\gluonfx\x86_64-windows\DiskSpace.exe > stdout.txt 2>&1
          Side effect: a black console window pops up when launched from Explorer. Strictly
          a debug profile — never ship a console-subsystem build to end users.
        -->
        <profile>
            <id>native-console</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.gluonhq</groupId>
                        <artifactId>gluonfx-maven-plugin</artifactId>
                        <version>${gluonfx-maven-plugin.version}</version>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <nativeImageArgs>
                                <arg>-H:NativeLinkerOption=/SUBSYSTEM:CONSOLE</arg>
                            </nativeImageArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
