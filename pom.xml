<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>se.hirt</groupId>
    <artifactId>diskspace</artifactId>
    <version>0.3.4-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>DiskSpace</name>
    <description>A cross-platform disk space visualizer in Java + JavaFX.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <javafx.version>25.0.5.1</javafx.version>
        <native.icon.skip>true</native.icon.skip>
        <main.class>se.hirt.diskspace.App</main.class>

        <resources-plugin.version>3.3.1</resources-plugin.version>
        <compiler-plugin.version>3.16.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.2</surefire-plugin.version>
        <enforcer-plugin.version>3.7.0</enforcer-plugin.version>
        <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>
        <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
        <native-maven-plugin.version>1.1.19</native-maven-plugin.version>
        <graalvm-sdk.version>25.0.2</graalvm-sdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- GraalVM Native Image API. Provides @CFunction / @Platforms / ImageInfo / etc.
             used to call OS native APIs directly from MftScanner, WindowsElevation,
             Win32StorageProbe, MacBulkScanner, and MacStorageProbe.
             Compile scope (not provided): the SDK classes need to be on the JVM-mode runtime
             classpath too, because the scanner/capability class graph references Word/Pointer
             types even though native paths are gated behind ImageInfo.inImageRuntimeCode().
             Native-image build coexists fine — Substrate uses its own SDK classes. -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>${graalvm-sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          Two resource blocks so AppInfo.version() can read pom.xml's <version>
          without a hand-maintained constant: app.properties contains literal
          ${project.version} on disk; the filtered block substitutes it at
          process-resources time. Everything else (icons, themes, LICENSE.txt)
          passes through unfiltered so binary resources aren't at risk of being
          rewritten by Maven's filter. Declaring any <resources> block replaces
          the implicit default, so both blocks have to be spelled out.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>se/hirt/diskspace/app.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>se/hirt/diskspace/app.properties</exclude>
                </excludes>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${resources-plugin.version}</version>
                <configuration>
                    <propertiesEncoding>${project.build.sourceEncoding}</propertiesEncoding>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <!-- Dev runner: `mvn javafx:run` launches the app on the JVM. Native scanners
                 (MFT / getattrlistbulk) are disabled in JVM mode (the @CFunction bindings
                 only resolve in native-image builds), so dev mode falls back to the
                 parallel directory scanner. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx-maven-plugin.version}</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Debug logging + JFR for `mvn javafx:run`:
            * -Ddiskspace.log.level=FINE   → se.hirt.diskspace.* logs at FINE level
            * StartFlightRecording=...     → JFR recording running for the whole session,
                                              dumped to diskspace.jfr in the working dir on
                                              exit. Open with `jfr summary diskspace.jfr`
                                              or load in JDK Mission Control / VisualVM.
                                              `settings=profile` captures methods + locks +
                                              GC + allocation; heavier than `default` but
                                              what you want for diagnosing freezes.
          Run: `mvn -Pdebug-logging javafx:run`
        -->
        <profile>
            <id>debug-logging</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <options>
                                <option>--enable-native-access=javafx.graphics</option>
                                <option>-Ddiskspace.log.level=FINE</option>
                                <option>-XX:StartFlightRecording=name=diskspace,filename=diskspace.jfr,dumponexit=true,settings=profile</option>
                            </options>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Native build via GraalVM Native Image 25 + standard OpenJFX (no GluonFX).
          JavaFX shared libraries, shaders, and styles are embedded as resources using
          per-platform reachability metadata under config/native/<platform>/.
          Run: `mvn -Pnative -DskipTests clean package`
          Output: `target/native/DiskSpace` (or `target/native/DiskSpace.exe` on Windows).
          Prerequisites: Oracle GraalVM for JDK 25 + native-image, plus platform toolchain
            (Windows: VS 2022 with C++ workload; macOS: Xcode CLT; Linux: build-essential + zlib1g-dev).
        -->
        <profile>
            <id>native</id>
            <properties>
                <native.icon.skip>false</native.icon.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>${enforcer-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>require-java-25</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireJavaVersion>
                                            <version>[25,26)</version>
                                        </requireJavaVersion>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <configuration>
                            <mainClass>se.hirt.diskspace.Launcher</mainClass>
                            <imageName>DiskSpace</imageName>
                            <outputDirectory>${project.build.directory}/native</outputDirectory>
                            <metadataRepository>
                                <enabled>false</enabled>
                            </metadataRepository>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <!-- Omit exact-reachability-metadata alongside JFR monitoring:
                                     on Oracle GraalVM 25.0.5 macOS, that combination breaks DarwinTimeUtil.nanoTime()
                                     with ArithmeticException: / by zero whenever a JFR event (such as ThreadSleep)
                                     fires. -->
                                <buildArg>-march=compatibility</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <buildArg>-H:+IncludeAllLocales</buildArg>
                                <buildArg>-H:-UnlockExperimentalVMOptions</buildArg>
                                <buildArg>-H:ConfigurationFileDirectories=${project.basedir}/config/native/${native.platform}</buildArg>
                                <!-- Cap the heap at 4 GB. Serial GC's stop-the-world full
                                     collections scale with heap size; without a cap, Substrate
                                     ergonomics let the heap grow toward 80% of physical RAM
                                     (MaximumHeapSizePercent=80), which on a 64 GB machine
                                     means full GCs that pause for seconds. 4 GB is comfortable
                                     for a multi-TB volume scan (the DirectoryNode tree for
                                     ~4 M files is well under 1 GB) and keeps worst-case Serial
                                     pauses bounded. -->
                                <buildArg>-R:MaxHeapSize=4g</buildArg>
                                <!-- Pin the initial heap at 1 GB so a large scan doesn't trigger
                                     a sequence of stop-the-world heap-expansion GCs as the
                                     DirectoryNode tree grows from ~0 → ~hundreds of MB. -->
                                <buildArg>-R:MinHeapSize=1g</buildArg>
                                <!-- GC logging via `-R:+PrintGC` is intentionally NOT enabled:
                                     Windows GUI subsystem exes have an invalid stderr handle by
                                     default and native GC writes segfault on first write. Use
                                     JVM-mode JFR for Windows GC diagnostics. -->
                                <!-- Quarantine the build-host JVM from other Java processes on
                                     the box (JMC, IntelliJ, etc.) so probing its attach socket
                                     doesn't pull sun.rmi.* into the image build. -->
                                <buildArg>-J-XX:-UsePerfData</buildArg>
                                <buildArg>-J-XX:+DisableAttachMechanism</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Mac-auto-activated: selects macOS metadata and links Darwin frameworks used by
             MacStorageProbe / MacBulkScanner (CoreFoundation, DiskArbitration, IOKit). -->
        <profile>
            <id>native-mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <native.platform>macos</native.platform>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <configuration>
                            <buildArgs combine.children="append">
                                <buildArg>--enable-monitoring=jfr</buildArg>
                                <buildArg>-R:+FlightRecorder</buildArg>
                                <buildArg>-H:NativeLinkerOption=-framework</buildArg>
                                <buildArg>-H:NativeLinkerOption=CoreFoundation</buildArg>
                                <buildArg>-H:NativeLinkerOption=-framework</buildArg>
                                <buildArg>-H:NativeLinkerOption=DiskArbitration</buildArg>
                                <buildArg>-H:NativeLinkerOption=-framework</buildArg>
                                <buildArg>-H:NativeLinkerOption=IOKit</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Linux-auto-activated: selects Linux metadata (covers both ES2 and SW pipelines). -->
        <profile>
            <id>native-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <native.platform>linux</native.platform>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <configuration>
                            <buildArgs combine.children="append">
                                <buildArg>--enable-monitoring=jfr</buildArg>
                                <buildArg>-R:+FlightRecorder</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Windows-auto-activated: selects Windows metadata, compiles the .ico resource into
             a .res file during native builds, links GUI subsystem + Advapi32 + Shell32. -->
        <profile>
            <id>native-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <native.platform>windows</native.platform>
                <native.windows.subsystem>WINDOWS</native.windows.subsystem>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>compile-windows-icon</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${native.icon.skip}</skip>
                                    <executable>rc.exe</executable>
                                    <workingDirectory>${project.basedir}/src/windows</workingDirectory>
                                    <arguments>
                                        <argument>/nologo</argument>
                                        <argument>/fo</argument>
                                        <argument>${project.build.directory}/diskspace-icon.res</argument>
                                        <argument>diskspace-icon.rc</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <configuration>
                            <buildArgs combine.children="append">
                                <buildArg>-H:NativeLinkerOption=${project.build.directory}/diskspace-icon.res</buildArg>
                                <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:${native.windows.subsystem}</buildArg>
                                <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                                <buildArg>-H:NativeLinkerOption=Advapi32.lib</buildArg>
                                <buildArg>-H:NativeLinkerOption=Shell32.lib</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Builds the native exe as a Windows console-subsystem binary so stdout/stderr stay
          attached to the launching shell:
            `mvn -Pnative,native-console -DskipTests clean package`
            target\native\DiskSpace.exe > stdout.txt 2>&1
          Side effect: a black console window pops up when launched from Explorer. Strictly
          a debug profile — never ship a console-subsystem build to end users.
        -->
        <profile>
            <id>native-console</id>
            <properties>
                <native.windows.subsystem>CONSOLE</native.windows.subsystem>
            </properties>
        </profile>
    </profiles>
</project>
