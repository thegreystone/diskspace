<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- JavaFX bundles several third-party native libraries (libjfxgl, libdecora, etc.)
         that are NOT signed with our Developer ID. Library validation under hardened
         runtime would reject them. This entitlement allows them to load. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
